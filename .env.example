# ==============================================================================
# Web Voice Bot — Local Environment Template (.env.example)
# ==============================================================================
# 使用方式：
#   推薦直接執行 start-win11.ps1 (Windows) 或 ./start-linux.sh (Linux)，
#   腳本會以「隱藏輸入」自動幫你建立本機 .env 並檢查金鑰格式。
#
# 安全提醒（防呆）：
#   1. 請勿把真實金鑰填在這個 .env.example 檔案裡！
#   2. 本機真實金鑰請放在 .env（已在 .gitignore 排除，不會被 git push）。
#   3. 申請免費 Gemini API Key：https://aistudio.google.com/apikey
# ==============================================================================

# [必填] Gemini API Key（通常以 AIza 開頭，請勿包含空白或引號外多餘字元）
GEMINI_API_KEY=""

# [選填] 自訂模型 ID；留空即可使用內建低延遲預設模型
GEMINI_MODEL=""
GEMINI_FALLBACK_MODEL=""

# [選填] 伺服器監聽位址與埠號（本機預設僅綁定 127.0.0.1:3000 防止區網誤連）
HOST="127.0.0.1"
PORT="3000"

# [選填] 對外網址（本機使用預設 http://localhost:3000 即可）
APP_URL="http://localhost:3000"

# [選填；遠端存取時必填] API 存取權杖（請用長且隨機的字串，例如：openssl rand -hex 32）
# 規則：
#   - 沒設定：只允許「本機直連」(127.0.0.1)。經反向代理轉送（帶 X-Forwarded-* 等標頭）的請求
#     一律視為遠端並回 403，雲端環境（Cloud Run / AI Studio）也不例外。
#   - 有設定：所有受保護路由都必須帶 `Authorization: Bearer <token>`；網頁介面會在需要時跳出視窗請你輸入。
# 受保護路由：/api/*（含 /api/bot、/api/observability、/api/compliance、/api/download）、
#            /metrics、/web-voice-bot-complete.zip。只有 /health 與 /ready 永遠公開（供健康檢查）。
WEB_API_TOKEN=""

# [選填] 若將伺服器對外開放，建議額外設定管理端點保護權杖
# 設定後呼叫 /api/bot/config 與 /api/bot/run-tests 需帶 X-Admin-Token 標頭
ADMIN_API_TOKEN=""

# [選填] 可觀測性設定（Prometheus Metrics / JSON 結構化日誌 / OpenTelemetry）
LOG_FORMAT="json"
METRICS_HOST="127.0.0.1"
METRICS_PORT="9090"
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="telegram-voice-bot"

# [選填] 防惡意機器人中介軟體（驗證所有 /api/bot/* 請求；BOT_GUARD_SECRET 留空時每次啟動於記憶體自動產生隨機金鑰，若設定後外部呼叫端可帶 X-Bot-Guard-Secret 或透過 /api/bot/challenge 簽發之 X-Bot-Guard-Token）
BOT_GUARD_ENABLED="true"
BOT_GUARD_SECRET=""

# ==============================================================================
# [選填] 以下僅在你需要啟用「Gmail OAuth 寄送 Patch」分頁時才需填寫；
# 只使用 Web Voice Bot 語音對話可全部留空。
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_DEFAULT_RECIPIENT_EMAIL=""
