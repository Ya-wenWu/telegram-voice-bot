# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Allowed Telegram user IDs (comma-separated). Empty = deny all.
ALLOWED_USER_IDS=

# OpenCode Zen API (used by bot/opencode_client.py)
ZEN_API_KEY=

# TTS voice
TTS_VOICE=zh-CN-XiaoxiaoNeural

# Remote transcription (OpenAI-compatible). Groq free tier by default.
WHISPER_API_BASE=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo

# Optional self-hosted Whisper server; when set, WHISPER_API_* is ignored.
# WHISPER_URL=http://127.0.0.1:12017

# Redis (daily quotas only; failures fail open)
REDIS_URL=redis://127.0.0.1:6379/0
DAILY_REQUEST_LIMIT=50
TIMEZONE=Asia/Taipei

# Resource guards
MAX_VOICE_BYTES=10485760
# TMP_DIR=~/.cache/telegram-voice-bot/tmp

# Bot tuning (1 vCPU / 1.4 GiB host)
BOT_WORKERS=1
CONCURRENT_UPDATES=1