# Template for .env — built-in defaults are defined in bot/config.py.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Allowed Telegram user IDs (comma-separated). Empty = deny all.
ALLOWED_USER_IDS=

# OpenAI-compatible LLM endpoint (used by bot/opencode_client.py).
# Uncomment the defaults below or replace them to override bot/config.py.
# ZEN_API_BASE=https://opencode.ai/inference/openai/v1
# ZEN_MODEL=deepseek-v4.1-flash-free
ZEN_API_KEY=
ZEN_MAX_TOKENS=1024

# Pluggable TTS backend: edge | openai | piper (Issue #25)
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
# OpenAI-compatible TTS settings (used when TTS_PROVIDER=openai)
# TTS_API_BASE=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# Local Piper settings (used when TTS_PROVIDER=piper)
# PIPER_BIN=piper
# PIPER_MODEL_PATH=

# Remote transcription (OpenAI-compatible).
WHISPER_API_BASE=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo
# Transcription language hint; set empty to auto-detect.
WHISPER_LANGUAGE=zh
# Optional self-hosted Whisper server; when set, WHISPER_API_* is ignored.
# WHISPER_URL=http://127.0.0.1:12017

# Conversation memory bounds (Issue #26; 0 = stateless)
CONVERSATION_MAX_TURNS=6
CONVERSATION_TTL_SEC=3600

# Redis (daily quotas only; failures fail open)
REDIS_URL=redis://127.0.0.1:6379/0
DAILY_REQUEST_LIMIT=50
TIMEZONE=Asia/Taipei

# Resource guards & runtime directories
MAX_VOICE_BYTES=10485760
# TMP_DIR=~/.cache/telegram-voice-bot/tmp
# STATE_DIR=~/.local/state/telegram-voice-bot

# Bot tuning (1 vCPU / 1.4 GiB host)
BOT_WORKERS=1
CONCURRENT_UPDATES=1
BOT_QUEUE_MAXSIZE=10
TTS_TIMEOUT_SEC=15
FFMPEG_TIMEOUT_SEC=30
